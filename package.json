{
  "name": "yooka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Yooka — conteúdo de IA e automação para empresas brasileiras. Gerador estático próprio.",
  "scripts": {
    "build": "node build.js && node scripts/generate-og.js",
    "build:fast": "node build.js",
    "dev": "node build.js && npx --yes serve public -l 4321",
    "og": "node scripts/generate-og.js",
    "check:links": "node scripts/check-links.js",
    "indexnow": "node scripts/indexnow.js",
    "activate:domain": "node scripts/activate-domain.js",
    "sitemap": "cat public/sitemap.xml",
    "deploy": "vercel deploy --prod",
    "deploy:preview": "vercel deploy"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  }
}
